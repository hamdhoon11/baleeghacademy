# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=instance/portal.db
# ---- Persistent storage (leave both blank to keep using the local SQLite file and local uploads folder) ----
# Hosted PostgreSQL address (Supabase / Neon / Render / Railway). If the host offers a "pooled" or "transaction pooler" address, use that one on Vercel.
DATABASE_URL=
# Uploaded files (ID copies, payment slips, assignments, materials) in an S3-compatible bucket: Supabase Storage, Cloudflare R2, Backblaze B2, AWS S3.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: keep this portal's files under a folder name inside a shared bucket
S3_PREFIX=
# First start only: demo teacher/student accounts are created on SQLite but NOT on hosted PostgreSQL. Set 1 to force them on, 0 to force them off.
SEED_DEMO=
# Comma-separated origins allowed to call the API (your Netlify site)
CORS_ORIGINS=https://baleeghacademy.netlify.app
TOKEN_HOURS=8
# Join class button appears this many minutes before a class starts
JOIN_EARLY_MIN=15
# Largest allowed upload for assignment submissions and class materials (MB, max 24)
LEARNING_MAX_MB=20

# ---- Phase 4: fees ----
# Slip uploads allowed per student per hour
SLIP_LIMIT=10
# Optional font note: receipts are English; no extra font needed.
# Email reminders are OFF by default. Nothing is sent unless EMAIL_ENABLED=1 AND the SMTP settings are filled in.
# (TODO owner: choose the email service. Google Workspace SMTP would be smtp.gmail.com, port 587, STARTTLS, with an app password.)
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Long random string. Vercel Cron sends it as 'Authorization: Bearer <value>' to /api/cron/generate-invoices (daily). Blank = endpoint closed.
CRON_SECRET=
